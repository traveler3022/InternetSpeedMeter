<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:clipToOutline="true"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <!-- Session header on the gradient -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_session_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="00:00:00"
                android:textColor="@color/White"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/session_time"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_session_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0 B"
                android:textColor="@color/White"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/session_usage"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- VIEW 1: live speed graph + Mobile|Wifi (entry into app usage) -->
    <LinearLayout
        android:id="@+id/graph_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <com.vsp.internetspeedmeter.GraphView
            android:id="@+id/graph_view"
            android:layout_width="match_parent"
            android:layout_height="190dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_toggle_track"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/btn_graph_mobile"
                android:layout_width="110dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_toggle_pill"
                android:gravity="center"
                android:text="@string/tab_mobile"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_graph_wifi"
                android:layout_width="110dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_toggle_pill"
                android:gravity="center"
                android:text="@string/tab_wifi"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- VIEW 2: app usage list (scrolls in a fixed box) + Mobile|Wifi below it -->
    <LinearLayout
        android:id="@+id/apps_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_apps"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_app_usage" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/bg_toggle_track"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/btn_apps_mobile"
                android:layout_width="110dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_toggle_pill"
                android:gravity="center"
                android:text="@string/tab_mobile"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_apps_wifi"
                android:layout_width="110dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_toggle_pill"
                android:gravity="center"
                android:text="@string/tab_wifi"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
