<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/ismDialogBody"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <!-- Session header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/ismHeader"
        android:orientation="horizontal"
        android:paddingVertical="11dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_session_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/White"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_time"
                android:textColor="#E2E2E2"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_session_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 B"
                android:textColor="@color/White"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_usage"
                android:textColor="#E2E2E2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- VIEW 1: live speed graph + Mobile|Wifi (entry into app usage) -->
    <LinearLayout
        android:id="@+id/graph_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/ismCard"
        android:orientation="vertical">

        <com.vsp.internetspeedmeter.GraphView
            android:id="@+id/graph_view"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/ismFooter"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_graph_mobile"
                android:layout_width="110dp"
                android:layout_height="32dp"
                android:background="?attr/ismCard"
                android:gravity="center"
                android:text="@string/tab_mobile"
                android:textColor="?attr/ismMuted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_graph_wifi"
                android:layout_width="110dp"
                android:layout_height="32dp"
                android:background="?attr/ismCard"
                android:gravity="center"
                android:text="@string/tab_wifi"
                android:textColor="?attr/ismMuted"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- VIEW 2: app usage list (scrolls in a fixed box) + Mobile|Wifi below it -->
    <LinearLayout
        android:id="@+id/apps_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/ismDialogBody"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_apps"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_app_usage" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/ismFooter"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_apps_mobile"
                android:layout_width="110dp"
                android:layout_height="32dp"
                android:background="?attr/ismHeader"
                android:gravity="center"
                android:text="@string/tab_mobile"
                android:textColor="@color/White"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_apps_wifi"
                android:layout_width="110dp"
                android:layout_height="32dp"
                android:background="?attr/ismCard"
                android:gravity="center"
                android:text="@string/tab_wifi"
                android:textColor="?attr/ismMuted"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
