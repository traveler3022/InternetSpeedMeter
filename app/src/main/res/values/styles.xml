<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ Base app theme (Material 3) ============
         Palette.kt applies one of the ThemeOverlay.Ism.* styles on top of this
         before setContentView(), so every ism* token below is the light-blue
         default and is overridden per palette. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_deep</item>
        <item name="colorOnPrimary">@color/White</item>
        <item name="colorSecondary">@color/wifi_tint</item>
        <item name="colorOnSecondary">@color/White</item>

        <item name="android:windowBackground">?attr/ismPage</item>
        <item name="android:statusBarColor">?attr/ismBar</item>
        <item name="android:navigationBarColor">?attr/ismBar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="ismPage">#F4F7FC</item>
        <item name="ismBar">#F4F7FC</item>
        <item name="ismHeader">#2563EB</item>
        <item name="ismRowDark">#DBEAFE</item>
        <item name="ismRowLight">#EFF4FE</item>
        <item name="ismRowLighter">#FFFFFF</item>
        <item name="ismCellText">#10192B</item>
        <item name="ismDialogBody">#F8FAFD</item>
        <item name="ismCard">#FFFFFF</item>
        <item name="ismFooter">#EEF2F9</item>
        <item name="ismMuted">#5B6B84</item>
        <item name="ismGrid">#E3E9F4</item>
        <item name="ismAccent">#2563EB</item>
        <item name="ismAccentSoft">#DBEAFE</item>
        <item name="ismOnSoft">#1E40AF</item>
        <item name="ismAccentDeep">#1D4ED8</item>
    </style>

    <!-- Dialog shown when the notification is tapped (DialogActivity) -->
    <style name="AppTheme.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_deep</item>
        <item name="colorSecondary">@color/wifi_tint</item>
        <item name="android:windowBackground">@color/Transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Flat modern toolbar: same color as the page, bold title -->
    <style name="IsmToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/ismBar</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <item name="titleTextAppearance">@style/IsmToolbarTitle</item>
        <item name="popupTheme">@style/ThemeOverlay.Material3.Light</item>
    </style>

    <style name="IsmToolbarTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Pill indicator behind the active bottom-nav item -->
    <style name="IsmNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/ismAccentSoft</item>
    </style>

    <!-- Bottom-nav label text -->
    <style name="IsmNavText">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ============ Cards & typography ============ -->

    <style name="IsmCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="cardBackgroundColor">?attr/ismCard</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="IsmCardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Big stat numbers: bold + tabular figures -->
    <style name="IsmBigNumber">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFeatureSettings" tools:targetApi="21">tnum</item>
    </style>

    <style name="IsmCaption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Numbers on the gradient hero card -->
    <style name="IsmHeroNumber">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:fontFeatureSettings" tools:targetApi="21">tnum</item>
    </style>

    <style name="IsmHeroLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#B3FFFFFF</item>
    </style>

    <!-- ============ Table header (history) ============ -->
    <style name="TableHeaderCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/ismOnSoft</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ============ The three "تم" palettes, applied by Palette.apply() ============ -->

    <!-- Blue (light) -->
    <style name="ThemeOverlay.Ism.Blue" parent="">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_deep</item>
        <item name="colorSecondary">@color/wifi_tint</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="ismPage">#F4F7FC</item>
        <item name="ismBar">#F4F7FC</item>
        <item name="ismHeader">#2563EB</item>
        <item name="ismRowDark">#DBEAFE</item>
        <item name="ismRowLight">#EFF4FE</item>
        <item name="ismRowLighter">#FFFFFF</item>
        <item name="ismCellText">#10192B</item>
        <item name="ismDialogBody">#F8FAFD</item>
        <item name="ismCard">#FFFFFF</item>
        <item name="ismFooter">#EEF2F9</item>
        <item name="ismMuted">#5B6B84</item>
        <item name="ismGrid">#E3E9F4</item>
        <item name="ismAccent">#2563EB</item>
        <item name="ismAccentSoft">#DBEAFE</item>
        <item name="ismOnSoft">#1E40AF</item>
        <item name="ismAccentDeep">#1D4ED8</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Purple (light) -->
    <style name="ThemeOverlay.Ism.Purple" parent="">
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorPrimaryVariant">@color/brand_purple_deep</item>
        <item name="colorSecondary">@color/wifi_tint</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="ismPage">#F7F5FC</item>
        <item name="ismBar">#F7F5FC</item>
        <item name="ismHeader">#7C3AED</item>
        <item name="ismRowDark">#EDE9FE</item>
        <item name="ismRowLight">#F3EFFC</item>
        <item name="ismRowLighter">#FFFFFF</item>
        <item name="ismCellText">#1E1435</item>
        <item name="ismDialogBody">#FAF8FE</item>
        <item name="ismCard">#FFFFFF</item>
        <item name="ismFooter">#F0EBF8</item>
        <item name="ismMuted">#625983</item>
        <item name="ismGrid">#E7E1F4</item>
        <item name="ismAccent">#7C3AED</item>
        <item name="ismAccentSoft">#EDE9FE</item>
        <item name="ismOnSoft">#5B21B6</item>
        <item name="ismAccentDeep">#6D28D9</item>
        <item name="android:textColorPrimary">@color/text_primary_purple</item>
        <item name="android:textColorSecondary">@color/text_secondary_purple</item>
    </style>

    <!-- Dark -->
    <style name="ThemeOverlay.Ism.Dark" parent="">
        <item name="colorPrimary">@color/brand_dark</item>
        <item name="colorPrimaryVariant">@color/brand_dark_deep</item>
        <item name="colorSecondary">@color/wifi_tint</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="ismPage">#0E1116</item>
        <item name="ismBar">#0E1116</item>
        <item name="ismHeader">#3B6FE0</item>
        <item name="ismRowDark">#212B3E</item>
        <item name="ismRowLight">#1A2130</item>
        <item name="ismRowLighter">#141924</item>
        <item name="ismCellText">#E7EDF7</item>
        <item name="ismDialogBody">#131820</item>
        <item name="ismCard">#171C24</item>
        <item name="ismFooter">#1B2330</item>
        <item name="ismMuted">#9AA7BC</item>
        <item name="ismGrid">#232D3D</item>
        <item name="ismAccent">#4F8EF7</item>
        <item name="ismAccentSoft">#1E2A45</item>
        <item name="ismOnSoft">#9DB8F5</item>
        <item name="ismAccentDeep">#2E5FD0</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>
</resources>
