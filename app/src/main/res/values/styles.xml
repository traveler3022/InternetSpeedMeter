<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ Base app theme (Material 3) ============
         Palette.kt applies one of the ThemeOverlay.Ism.* styles on top of this
         before setContentView(), so every ism* token below is the light-blue
         default and is overridden per palette. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_deep</item>
        <item name="colorOnPrimary">@color/White</item>
        <item name="colorSecondary">@color/wifi_tint</item>
        <item name="colorOnSecondary">@color/White</item>

        <item name="android:windowBackground">?attr/ismPage</item>
        <item name="android:statusBarColor">?attr/ismBar</item>
        <item name="android:navigationBarColor">?attr/ismBar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="ismPage">#F3F6FC</item>
        <item name="ismBar">#F3F6FC</item>
        <item name="ismHeader">#2563EB</item>
        <item name="ismRowDark">#DBE6FD</item>
        <item name="ismRowLight">#F1ECFE</item>
        <item name="ismRowLighter">#EAF1FE</item>
        <item name="ismCellText">#10192B</item>
        <item name="ismDialogBody">#EEF3FD</item>
        <item name="ismCard">#E9EFFC</item>
        <item name="ismFooter">#DEE6F6</item>
        <item name="ismMuted">#5B6B84</item>
        <item name="ismGrid">#D6DEEE</item>
        <item name="ismAccent">#2563EB</item>
        <item name="ismAccentSoft">#D4E2FF</item>
        <item name="ismOnSoft">#1E40AF</item>
        <item name="ismAccentDeep">#7C3AED</item>
        <item name="ismCardBlue">#E2ECFF</item>
        <item name="ismCardTeal">#D9F4EE</item>
        <item name="ismCardViolet">#ECE5FF</item>
        <item name="ismCardAmber">#FFEFD9</item>
        <item name="ismViolet">#7C3AED</item>
        <item name="ismAmber">#D97706</item>
        <item name="colorPrimaryContainer">@color/m3b_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3b_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/m3b_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3b_on_secondary_container</item>
        <item name="colorTertiary">@color/m3b_tertiary</item>
        <item name="colorOnTertiary">@color/White</item>
        <item name="colorTertiaryContainer">@color/m3b_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3b_on_tertiary_container</item>
        <item name="android:colorBackground">@color/m3b_surface</item>
        <item name="colorSurface">@color/m3b_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/m3b_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3b_on_surface_variant</item>
        <item name="colorOutline">@color/m3b_outline</item>
        <item name="colorOutlineVariant">@color/m3b_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3b_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3b_container_low</item>
        <item name="colorSurfaceContainer">@color/m3b_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3b_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3b_container_highest</item>
    </style>

    <!-- Dialog shown when the notification is tapped (DialogActivity) -->
    <style name="AppTheme.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_deep</item>
        <item name="colorSecondary">@color/wifi_tint</item>
        <item name="android:windowBackground">@color/Transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Flat modern toolbar: same color as the page, bold title -->
    <style name="IsmToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/ismBar</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <item name="titleTextAppearance">@style/IsmToolbarTitle</item>
        <item name="popupTheme">@style/ThemeOverlay.Material3.Light</item>
    </style>

    <style name="IsmToolbarTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Pill indicator behind the active bottom-nav item -->
    <style name="IsmNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/ismAccentSoft</item>
    </style>

    <!-- Bottom-nav label text -->
    <style name="IsmNavText">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ============ Cards & typography ============ -->

    <style name="IsmCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="cardBackgroundColor">?attr/ismCard</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Pastel cards, one hue per kind of card -->
    <style name="IsmCard.Blue">
        <item name="cardBackgroundColor">?attr/ismCardBlue</item>
    </style>

    <style name="IsmCard.Teal">
        <item name="cardBackgroundColor">?attr/ismCardTeal</item>
    </style>

    <style name="IsmCard.Violet">
        <item name="cardBackgroundColor">?attr/ismCardViolet</item>
    </style>

    <style name="IsmCard.Amber">
        <item name="cardBackgroundColor">?attr/ismCardAmber</item>
    </style>

    <style name="IsmCardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Big stat numbers: bold + tabular figures -->
    <style name="IsmBigNumber">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFeatureSettings" tools:targetApi="21">tnum</item>
    </style>

    <style name="IsmCaption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Numbers on the gradient hero card -->
    <style name="IsmHeroNumber">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:fontFeatureSettings" tools:targetApi="21">tnum</item>
    </style>

    <style name="IsmHeroLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#B3FFFFFF</item>
    </style>

    <!-- ============ Table header (history) ============ -->
    <style name="TableHeaderCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/ismOnSoft</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

