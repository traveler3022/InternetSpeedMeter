<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/White</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:windowBackground">?attr/ismPage</item>
        <item name="android:statusBarColor">?attr/ismPage</item>
        <item name="android:navigationBarColor">?attr/ismPage</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="ismPage">#F5F7FB</item>
        <item name="ismBar">#F5F7FB</item>
        <item name="ismHeader">#3B86F0</item>
        <item name="ismRowDark">#DDE7F4</item>
        <item name="ismRowLight">#F5F8FC</item>
        <item name="ismRowLighter">#FBFCFE</item>
        <item name="ismCellText">#0B1220</item>
        <item name="ismDialogBody">#F7F9FC</item>
        <item name="ismCard">#FFFFFF</item>
        <item name="ismFooter">#E6EBF2</item>
        <item name="ismMuted">#667085</item>
        <item name="ismGrid">#E1E7EF</item>
        <item name="ismAccent">#3B82F6</item>
    </style>

    <style name="ToolbarBlack" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">?attr/ismPage</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <item name="android:theme">@style/ThemeOverlay.MaterialComponents.Light</item>
        <item name="popupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>
        <item name="contentInsetStartWithNavigation">16dp</item>
        <item name="contentInsetStart">16dp</item>
        <item name="contentInsetEnd">8dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="SettingsTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="colorPrimary">@color/bar_black</item>
        <item name="colorPrimaryVariant">@color/bar_black</item>
        <item name="colorOnPrimary">@color/White</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:windowBackground">?attr/ismPage</item>
        <item name="android:statusBarColor">?attr/ismPage</item>
    </style>

    <style name="IsmCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardBackgroundColor">?attr/ismCard</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/ismGrid</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">?attr/ismRowLight</item>
    </style>

    <style name="IsmCardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="IsmBigNumber">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="IsmCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="IsmLiveSpeed">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="IsmLiveLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="IsmListCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="cardBackgroundColor">?attr/ismCard</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/ismGrid</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TableHeaderCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ThemeOverlay.Ism.Blue" parent="">
        <item name="ismPage">#F5F7FB</item>
        <item name="ismBar">#F5F7FB</item>
        <item name="ismHeader">#2E6FCE</item>
        <item name="ismRowDark">#DDE7F4</item>
        <item name="ismRowLight">#F5F8FC</item>
        <item name="ismRowLighter">#FBFCFE</item>
        <item name="ismCellText">#0B1220</item>
        <item name="ismDialogBody">#F7F9FC</item>
        <item name="ismCard">#FFFFFF</item>
        <item name="ismFooter">#E6EBF2</item>
        <item name="ismMuted">#667085</item>
        <item name="ismGrid">#E1E7EF</item>
        <item name="ismAccent">#3B82F6</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="ThemeOverlay.Ism.Purple" parent="">
        <item name="ismPage">#F8F6FC</item>
        <item name="ismBar">#F8F6FC</item>
        <item name="ismHeader">#7550B3</item>
        <item name="ismRowDark">#E5DCF1</item>
        <item name="ismRowLight">#F6F2FB</item>
        <item name="ismRowLighter">#FCFAFE</item>
        <item name="ismCellText">#1A1030</item>
        <item name="ismDialogBody">#F8F6FB</item>
        <item name="ismCard">#FFFFFF</item>
        <item name="ismFooter">#E7E0EF</item>
        <item name="ismMuted">#6D627E</item>
        <item name="ismGrid">#E5DEED</item>
        <item name="ismAccent">#7E57C2</item>
        <item name="android:textColorPrimary">@color/text_primary_purple</item>
        <item name="android:textColorSecondary">@color/text_secondary_purple</item>
    </style>

    <style name="ThemeOverlay.Ism.Dark" parent="">
        <item name="ismPage">#0F141B</item>
        <item name="ismBar">#0F141B</item>
        <item name="ismHeader">#274F80</item>
        <item name="ismRowDark">#1B2633</item>
        <item name="ismRowLight">#202B39</item>
        <item name="ismRowLighter">#263241</item>
        <item name="ismCellText">#E6EAF0</item>
        <item name="ismDialogBody">#151B23</item>
        <item name="ismCard">#171E27</item>
        <item name="ismFooter">#29333F</item>
        <item name="ismMuted">#B4BDCA</item>
        <item name="ismGrid">#303B49</item>
        <item name="ismAccent">#5B9BF0</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>
</resources>